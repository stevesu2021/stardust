DATABASE_URL="postgresql://postgres:password@localhost:5432/stardust?schema=public"
JWT_SECRET="your-secret-key-change-in-production"
JWT_EXPIRATION="7d"
PORT=3000

# 文生图大模型 (火山方舟 豆包 doubao-seedream，AI头像生成)
ARK_T2I_API_KEY=""
ARK_T2I_URL="https://ark.cn-beijing.volces.com/api/plan/v3/images/generations"
ARK_T2I_MODEL="doubao-seedream-5.0-pro"

# 「星读」内容中心
ADMIN_TOKEN=""                    # admin 接口令牌（x-admin-token header），必配
CONTENT_AUTO_PUBLISH_DAILY="true" # 日报类（今日星象/黄历）AI 生成后是否自动发布